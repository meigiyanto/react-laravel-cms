+        </div>
+      </header>
+
+      {!slug ? <>
+        <section className="public-hero">
+          <div className="public-hero-copy"><span className="public-kicker">RUANG UNTUK IDE DAN CERITA</span><h1>Cerita yang baik<br /><em>layak dibagikan.</em></h1><p>Temukan artikel, wawasan, dan gagasan terbaru dari para penulis kami.</p>
+            <form className="public-search" onSubmit={(event) => { event.preventDefault(); setPage(1); setSearch(searchInput.trim()); }}><span aria-hidden="true">⌕</span><input aria-label="Cari artikel" placeholder="Cari topik atau artikel…" value={searchInput} onChange={(event) => { setSearchInput(event.target.value); setPage(1); }} /><button type="submit">Cari artikel</button></form>
+          </div>
+          <div className="public-hero-art" aria-hidden="true"><div className="hero-orbit orbit-one"/><div className="hero-orbit orbit-two"/><div className="hero-paper"><span>CATATAN HARI INI</span><strong>Temukan<br />perspektif<br /><i>baru.</i></strong><div className="paper-lines"/><div className="paper-sun"/></div><div className="hero-sticker">BACA<br />DAN<br />BERTUMBUH ↗</div></div>
+        </section>
+        <main className="public-main">
+          <div className="public-section-heading"><div><span className="public-kicker">DARI RUANG REDAKSI</span><h2>{search ? `Hasil untuk “${search}”` : category ? 'Artikel pilihan kategori' : 'Artikel terbaru'}</h2></div><span className="public-result-count">{posts ? `${posts.total} artikel` : 'Memuat artikel'}</span></div>
+          {allCategories.length > 0 && <div className="public-categories"><button className={!category ? 'selected' : ''} onClick={() => { setCategory(''); setPage(1); }}>Semua topik</button>{allCategories.map((cat) => <button key={cat.id} className={category === cat.slug ? 'selected' : ''} onClick={() => { setCategory(cat.slug); setPage(1); }}>{cat.name}</button>)}</div>}
