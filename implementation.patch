+          {loading ? <div className="public-loading" role="status">Menyiapkan cerita untukmu…</div> : posts?.data.length ? <div className="public-post-grid">{posts.data.map((item, index) => <article className={`public-post-card ${index === 0 && page === 1 && !search && !category ? 'featured-card' : ''}`} key={item.id}>
