+            <form className="comment-form" onSubmit={submitComment}><h3>Tulis komentar</h3><p>Komentar akan tampil setelah disetujui moderator.</p>{commentMessage && <div className="comment-success" role="status">{commentMessage}</div>}{commentError && <div className="public-alert" role="alert">{commentError}</div>}<div className="honeypot" aria-hidden="true"><label>Website<input tabIndex={-1} autoComplete="off" value={commentForm.website} onChange={(e) => setCommentForm({ ...commentForm, website: e.target.value })} /></label></div><label>Nama<input required minLength={2} maxLength={80} value={commentForm.name} onChange={(e) => setCommentForm({ ...commentForm, name: e.target.value })} placeholder="Nama yang ditampilkan" /></label><label>Email<input required type="email" maxLength={254} value={commentForm.email} onChange={(e) => setCommentForm({ ...commentForm, email: e.target.value })} placeholder="email@contoh.com" /></label><label>Komentar<textarea required minLength={3} maxLength={3000} rows={5} value={commentForm.body} onChange={(e) => setCommentForm({ ...commentForm, body: e.target.value })} placeholder="Tulis tanggapanmu dengan sopan…" /></label><button disabled={commentBusy} type="submit">{commentBusy ? 'Mengirim…' : 'Kirim komentar ↗'}</button></form></div></section>
+        </>}
+      </main>}
+      <footer className="public-footer"><div className="public-footer-inner"><div className="public-brand footer-brand"><span className="public-brand-mark">K</span><span>Kabar<span className="brand-light">CMS</span><small>IDE, CERITA, WAWASAN</small></span></div><p>Tempat gagasan bertemu cerita.</p><span>© {new Date().getFullYear()} KabarCMS</span></div></footer>
